[importlinter]
root_package = huddol
include_external_packages = true

[importlinter:contract:layers]
name = Layers run one way only
type = layers
layers =
    huddol.adapters
    huddol.runtime
    huddol.tools
    huddol.services
    huddol.ports
    huddol.core

[importlinter:contract:services]
name = Services do not know about each other
type = independence
modules =
    huddol.services.memory
    huddol.services.library
    huddol.services.history

[importlinter:contract:model-runtime]
name = Only adapters know the model runtime
type = forbidden
source_modules =
    huddol.core
    huddol.ports
    huddol.services
    huddol.tools
    huddol.runtime
forbidden_modules =
    pydantic_ai

[importlinter:contract:storage-network]
name = Only adapters touch storage and the network
type = forbidden
source_modules =
    huddol.core
    huddol.services
    huddol.tools
    huddol.runtime
forbidden_modules =
    sqlite3
    httpx
    subprocess

[importlinter:contract:core]
name = Core is self contained
type = forbidden
source_modules =
    huddol.core
forbidden_modules =
    huddol.ports
    huddol.services
    huddol.tools
    huddol.runtime
    huddol.adapters
